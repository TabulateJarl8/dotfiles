// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "proxy": "",
  "languages": {
    "Rust": {
      "semantic_tokens": "combined",
    }
  },
  "global_lsp_settings": {
    // disable lsp semantic token styling for comments so that the zed-comments extension can
    // highlight TODOs, WARNs, etc
    "semantic_token_rules": [
      {
        "token_type": "comment"
      }
    ]
  },
  "agent": {
    "button": false,
    "favorite_models": [],
    "model_parameters": []
  },
  "title_bar": {
    "show_branch_status_icon": false
  },
  "prettier": {
    "allowed": false
  },
  "format_on_save": "on",
  "minimap": {
    "show": "auto"
  },
  "relative_line_numbers": "enabled",
  "auto_signature_help": true,
  "auto_update": false,
  "cli_default_open_behavior": "new_window",
  "disable_ai": true,
  "vim_mode": true,
  "icon_theme": "Catppuccin Mocha",
  "project_panel": {
    "git_status_indicator": false,
    "dock": "left"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "buffer_font_features": {
    "calt": false
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Mocha",
  },
  "wrap_guides": [
    100
  ],
  "auto_install_extensions": {
    "html": true,
    "toml": true,
    "catppuccin": true,
    "catppuccin-icons": true,
    "discord-presence": true,
    "wakatime": true,
    "comment": true,
  },
  "theme_overrides": {
    "Catppuccin Mocha": {
      "syntax": {
        "constant.comment.todo": {
          "color": "#f9e2af",
          "background_color": "#313244",
          "font_weight": 600,
        },
        "string.comment.info": {
          "color": "#89b4fa",
          "background_color": "#313244",
          "font_weight": 600,
        },
        "keyword.comment.warn": {
          "color": "#fab387",
          "background_color": "#313244",
          "font_weight": 600,
        },
        "property.comment.error": {
          "color": "#f38ba8",
          "background_color": "#45475a",
          "font_weight": 600,
        },
      },
    },
  },
}
